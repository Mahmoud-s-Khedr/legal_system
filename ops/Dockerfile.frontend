# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build
# Installs dependencies and builds the React SPA with Vite.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /workspace
RUN corepack enable

# Build-time Vite env vars (baked into the static bundle)
ARG VITE_API_BASE_URL=/api
ARG VITE_SENTRY_DSN=
ARG VITE_FOOTER_NAME=ELMS

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ENV VITE_FOOTER_NAME=${VITE_FOOTER_NAME}

# Copy workspace manifests first (layer-cache friendly)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/frontend/package.json packages/frontend/package.json

# Install only frontend + shared dependencies
RUN pnpm install --frozen-lockfile --filter @elms/frontend --filter @elms/shared

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/frontend/ packages/frontend/

# Build the SPA (outputs to packages/frontend/dist/)
RUN pnpm --filter @elms/frontend build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Production image
# Serves the static bundle via Nginx.
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Nginx SPA config (handles client-side routing + asset caching)
COPY ops/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Static assets from builder
COPY --from=builder /workspace/packages/frontend/dist /usr/share/nginx/html

EXPOSE 80
