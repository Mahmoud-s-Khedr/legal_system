{
  "name": "@elms/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "pnpm build",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:tokens": "node ./scripts/check-tailwind-tokens.mjs",
    "lint:lookup-i18n": "node ./scripts/check-lookup-localization.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "i18n:check": "node ./scripts/check-i18n-keys.mjs && node ./scripts/check-lookup-localization.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@elms/shared": "workspace:*",
    "@sentry/react": "^10.22.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.134.2",
    "@tiptap/core": "^2.26.2",
    "@tiptap/extension-text-align": "^2.26.2",
    "@tiptap/extension-underline": "^2.26.2",
    "@tiptap/pm": "^2.26.2",
    "@tiptap/react": "^2.26.2",
    "@tiptap/starter-kit": "^2.26.2",
    "antd": "^6.3.4",
    "dayjs": "^1.11.20",
    "html-to-image": "^1.11.13",
    "i18next": "^25.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.1.0",
    "recharts": "^2.15.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tailwindcss-rtl": "^0.9.0",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^0.21.1"
  }
}
