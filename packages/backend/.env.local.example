NODE_ENV=development

# Target behavior
AUTH_MODE=local
STORAGE_DRIVER=local

# Network
HOST=127.0.0.1
BACKEND_PORT=7854
FRONTEND_PORT=5173

# Datastores
# Matches ops/docker-compose.dev.yml's expectation of Postgres on the standard port.
DATABASE_URL=postgresql://elms:elms@127.0.0.1:5432/elms_local?schema=public
# REDIS_URL is not used in AUTH_MODE=local (no cloud sessions or BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Auth — session
COOKIE_DOMAIN=localhost
LOCAL_SESSION_TTL_HOURS=12
# JWT TTLs below are unused in AUTH_MODE=local but kept so the schema parses cleanly
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated production CORS allowlist fallback for local runtime.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Default setup credentials (development only)
VITE_SETUP_EMAIL=admin@elms.local
VITE_SETUP_PASSWORD=password123
VITE_FOOTER_NAME=Mahmoud Khedr
VITE_FOOTER_EMAIL=mahmoud.s.khedr.2@gmail.com
VITE_FOOTER_PHONE=01016240934
VITE_FOOTER_LINKEDIN=https://www.linkedin.com/in/mahmoud-s-khedr/

# File storage (local runtime uses local filesystem)
MAX_UPLOAD_BYTES=52428800
# LOCAL_STORAGE_PATH is optional for workspace/dev runs.
DOCX_PREVIEW_ENABLED=true
DOCX_PREVIEW_BIN=libreoffice
DOCX_PREVIEW_TIMEOUT_MS=60000
OCR_BACKEND=tesseract
OCR_EMBEDDED_PDF_MAX_PAGES=2500
OCR_EMBEDDED_DOCX_MAX_IMAGES=3000
OCR_EMBEDDED_IMAGE_MAX_BYTES=1048576000
RESEARCH_USAGE_CACHE_TTL_MS=30000
DASHBOARD_CACHE_TTL_MS=5000
PERFORMANCE_LOGGING_ENABLED=false
PERFORMANCE_DB_SLOW_QUERY_MS=200
EXTRACTION_WORKER_CONCURRENCY=3
EXTRACTION_QUEUE_ATTEMPTS=3
EXTRACTION_QUEUE_BACKOFF_MS=5000
