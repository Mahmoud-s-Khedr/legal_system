NODE_ENV=development

# Target behavior
AUTH_MODE=cloud
STORAGE_DRIVER=local

# Shared application ports
HOST=0.0.0.0
BACKEND_PORT=7854
FRONTEND_PORT=5173
SAAS_BILLING_MODE=manual
VITE_API_BASE_URL=/api
VITE_SAAS_BILLING_MODE=manual
VITE_SENTRY_DSN=
VITE_FOOTER_NAME=Mahmoud Khedr
VITE_FOOTER_EMAIL=mahmoud.s.khedr.2@gmail.com
VITE_FOOTER_PHONE=01016240934
VITE_FOOTER_LINKEDIN=https://www.linkedin.com/in/mahmoud-s-khedr/
# Used by the frontend dev server to proxy /api requests to the backend.
BACKEND_URL=http://127.0.0.1:7854

# Datastores
DATABASE_URL=postgresql://elms:elms@127.0.0.1:5432/elms_cloud?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Auth
COOKIE_DOMAIN=localhost
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOCAL_SESSION_TTL_HOURS=12
# REQUIRED in production — generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
# REQUIRED in production — derive from private key with: openssl rsa -pubout
JWT_PUBLIC_KEY=
# Comma-separated list of allowed CORS origins in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# File storage
MAX_UPLOAD_BYTES=52428800
LOCAL_STORAGE_PATH=./uploads
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

# OCR and AI
OCR_BACKEND=tesseract
GOOGLE_VISION_API_KEY=
OCR_EMBEDDED_PDF_MAX_PAGES=2500
OCR_EMBEDDED_DOCX_MAX_IMAGES=3000
OCR_EMBEDDED_IMAGE_MAX_BYTES=1048576000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Maximum AI research messages per firm per month (0 = unlimited)
AI_MONTHLY_LIMIT=500
RESEARCH_USAGE_CACHE_TTL_MS=30000
DASHBOARD_CACHE_TTL_MS=5000
PERFORMANCE_LOGGING_ENABLED=false
PERFORMANCE_DB_SLOW_QUERY_MS=200
EXTRACTION_WORKER_CONCURRENCY=3
EXTRACTION_QUEUE_ATTEMPTS=3
EXTRACTION_QUEUE_BACKOFF_MS=5000
# Seed controls
ELMS_SEED_PROFILE=full
ELMS_SEED_VALUE=elms-dev-seed
ELMS_SEED_INCLUDE_INTEGRATIONS=true
# Perf controls
PERF_PROFILE=baseline
PERF_SUITES=api-baseline,auth,document-upload
PORTAL_FIRM_ID=8f4a6dd5-52b7-4b7c-93e5-2e5285d7009d
PERF_MAX_P50_REGRESSION_PCT=7
PERF_MAX_P95_REGRESSION_PCT=5
PERF_MAX_P99_REGRESSION_PCT=5
PERF_MAX_ERROR_REGRESSION_PCT=0

# Cloud services
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
CONNECT_MISR_API_KEY=
PAYMOB_API_KEY=
SENTRY_DSN=

# Email (SMTP) — used for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@elms.app

# SMS — set SMS_PROVIDER=twilio to enable
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
